{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-coirse-1-bootcamp-2day",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-07-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "VIBELAB_DB",
      "database_name": "taranom-hamdeli-db",
      "database_id": "fb4c6326-d73b-4fbf-bfdd-f9d8313ce6bf"
    }
  ],
  "observability": {
    "enabled": true
  }
}
